{
  "name": "displayforge",
  "private": true,
  "version": "0.6.0",
  "description": "Parametric LED wall builder (compound curves, custom shapes) with OBJ export and a disguise Designer plugin.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "three": "0.168.0",
    "vue": "3.4.38"
  },
  "devDependencies": {
    "@types/three": "0.168.0",
    "@vitejs/plugin-vue": "5.1.4",
    "typescript": "5.5.4",
    "vite": "5.4.10",
    "vitest": "2.1.4",
    "vue-tsc": "2.1.6"
  }
}
